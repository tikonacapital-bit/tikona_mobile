+#pragma once
+#include <string>
+#include <vector>
+
+#ifdef WORKLETS_PROFILING
+
+#if defined(__APPLE__)
+#include <os/trace_base.h>
+
+#if OS_LOG_TARGET_HAS_10_15_FEATURES
+#include <os/log.h>
