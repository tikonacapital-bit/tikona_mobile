+  // int dirtyWriters_{0};
+  bool blockingWriter_{false};
+  bool imperativelyLocked_{false};
+  pthread_t imperativeOwner_{};
+  std::mutex accessLock_;
+  std::recursive_mutex imperativeLock_;
+  std::condition_variable queue_;
+};
