# Copy this file to scripts/.env and fill in your values
# DO NOT commit scripts/.env to git

# Supabase Project URL (from Supabase Dashboard > Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SERVICE ROLE key (Settings > API > service_role secret key)
# This bypasses Row Level Security so the script can read all user portfolios
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: set to INFO or DEBUG
LOG_LEVEL=INFO
